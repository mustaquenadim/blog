# Copy this file to `.env.local` and fill in the values.
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored. Never commit real secrets — this file should only
# ever contain placeholders.
#
# NOTE: The application does not read any environment variables yet. Everything
# below is commented out and reserved for upcoming work. Uncomment entries as
# the features that need them land, and document each one here at the same time.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public base URL of the app. Used for absolute links, sitemaps, and metadata.
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Postgres connection string.
# DATABASE_URL="postgresql://user:password@localhost:5432/blog"

# ---------------------------------------------------------------------------
# Blog generation provider
# ---------------------------------------------------------------------------
# API key for the model provider backing blog generation.
# ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Secret used to sign sessions. Generate one with: openssl rand -base64 32
# AUTH_SECRET=""
